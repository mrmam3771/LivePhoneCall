# Public host port. Use 8443 when TLS is enabled.
QWEN_VOICE_PORT=8000

# Keep these blank for local HTTP. For microphone access from a phone, mount a
# trusted LAN certificate in .cert and use the paths below.
TLS_CERT_FILE=
TLS_KEY_FILE=
# TLS_CERT_FILE=/certs/lan-cert.pem
# TLS_KEY_FILE=/certs/lan-key.pem

ASR_GPU_MEMORY_UTILIZATION=0.45
ASR_MAX_MODEL_LEN=16384
MODEL_START_TIMEOUT=300
MODEL_CATALOG_PROXY=
